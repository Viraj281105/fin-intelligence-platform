# ==============================================================================
# Financial SLM Platform - Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
ENV=development
APP_NAME="Financial Intelligence SLM Platform"
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Model Settings
# Supported default base models:
# - Qwen/Qwen2.5-3B-Instruct
# - Qwen/Qwen2.5-Coder-3B-Instruct
# - meta-llama/Llama-3.2-3B-Instruct
# - microsoft/Phi-3.5-mini-instruct
BASE_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
ADAPTER_PATH=models/adapters/financial_slm_qlora
USE_4BIT=true
DEVICE=cuda

# Training Settings
TRAIN_BATCH_SIZE=1
GRADIENT_ACCUMULATION_STEPS=8
LEARNING_RATE=2e-4
MAX_SEQ_LENGTH=2048
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05

# Database Configuration (Financial Data Storage)
DATABASE_URL=sqlite:///data/financial_warehouse.db

# Vector Store (RAG)
VECTOR_DB_URL=http://localhost:6333
VECTOR_COLLECTION_NAME=financial_knowledge
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Security & Guardrails
ENABLE_PII_MASKING=true
ENABLE_SQL_VALIDATION=true
MAX_QUERY_LIMIT=500
API_SECRET_KEY=change-this-to-a-secure-secret-key-in-production

# External API Keys (Optional for synthetic generation or live market data)
HF_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=
