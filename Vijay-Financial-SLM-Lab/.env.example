# ==============================================================================
# Financial SLM Platform - Environment Configuration Scaffold
# ==============================================================================

# Application Environment (development, testing, production)
ENV=development
APP_NAME="Financial Intelligence SLM Platform"
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Base Model Selection
# Recommended starter options:
# - Qwen/Qwen2.5-3B-Instruct (Recommended for 8GB VRAM)
# - meta-llama/Llama-3.2-3B-Instruct
# - microsoft/Phi-3.5-mini-instruct
BASE_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
ADAPTER_PATH=models/adapters/financial_slm_qlora
USE_4BIT=true

# Training Hyperparameters (Optimized for Laptop GPU / 8GB VRAM)
TRAIN_BATCH_SIZE=1
GRADIENT_ACCUMULATION_STEPS=8
LEARNING_RATE=2e-4
MAX_SEQ_LENGTH=2048
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05

# Storage
DATABASE_URL=sqlite:///data/financial_warehouse.db

# API Keys (Optional)
HF_TOKEN=
